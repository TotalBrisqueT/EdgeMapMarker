<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>EdgeMapMarker</AssemblyName>
    <RootNamespace>EdgeMapMarker</RootNamespace>
    <!-- Also update Plugin.PluginVersion and CHANGELOG.md when this changes. -->
    <Version>0.1.2</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- The game's DLLs reference newer framework facade versions than netstandard2.1 ships; harmless at runtime. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <!--
    Where the game and the r2modman test profile live. Override either one with
    `dotnet build -p:ValheimDir=...` or `-p:ProfileDir=...` if yours differ.
  -->
  <PropertyGroup>
    <ValheimDir Condition="'$(ValheimDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimDir>
    <ProfileDir Condition="'$(ProfileDir)' == ''">$(APPDATA)\r2modmanPlus-local\Valheim\profiles\Dev</ProfileDir>
    <ManagedDir>$(ValheimDir)\valheim_Data\Managed</ManagedDir>
    <BepInExCoreDir>$(ProfileDir)\BepInEx\core</BepInExCoreDir>
    <PluginDeployDir>$(ProfileDir)\BepInEx\plugins\EdgeMapMarker</PluginDeployDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Makes the game's private fields and methods accessible at compile time. -->
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(BepInExCoreDir)\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExCoreDir)\0Harmony.dll" Private="false" />

    <Reference Include="assembly_valheim" HintPath="$(ManagedDir)\assembly_valheim.dll" Private="false" Publicize="true" />
    <Reference Include="assembly_utils" HintPath="$(ManagedDir)\assembly_utils.dll" Private="false" />
    <Reference Include="assembly_guiutils" HintPath="$(ManagedDir)\assembly_guiutils.dll" Private="false" />

    <Reference Include="UnityEngine" HintPath="$(ManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(ManagedDir)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(ManagedDir)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(ManagedDir)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(ManagedDir)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(ManagedDir)\Unity.TextMeshPro.dll" Private="false" />
  </ItemGroup>

  <!-- Thunderstore package details. The manifest is generated from these on every Release build. -->
  <PropertyGroup>
    <ThunderstoreName>EdgeMapMarker</ThunderstoreName>
    <ThunderstoreDescription>Keeps home, your chosen pins and friends on the edge of your minimap, with an arrow and distance, so you always know which way to go. Client-side.</ThunderstoreDescription>
    <ThunderstoreDependency>denikson-BepInExPack_Valheim-5.4.2351</ThunderstoreDependency>
    <RepoRoot>$(MSBuildProjectDirectory)\..</RepoRoot>
    <PackageStageDir>$(RepoRoot)\dist\stage</PackageStageDir>
  </PropertyGroup>

  <!-- Release builds also produce dist\EdgeMapMarker-<version>.zip, ready to upload to Thunderstore. -->
  <Target Name="ThunderstorePackage" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <RemoveDir Directories="$(PackageStageDir)" />
    <MakeDir Directories="$(PackageStageDir)\plugins" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PackageStageDir)\plugins" />
    <Copy SourceFiles="$(RepoRoot)\README.md;$(RepoRoot)\CHANGELOG.md;$(RepoRoot)\thunderstore\icon.png" DestinationFolder="$(PackageStageDir)" />
    <WriteLinesToFile File="$(PackageStageDir)\manifest.json" Overwrite="true" Lines="{;  &quot;name&quot;: &quot;$(ThunderstoreName)&quot;,;  &quot;version_number&quot;: &quot;$(Version)&quot;,;  &quot;website_url&quot;: &quot;&quot;,;  &quot;description&quot;: &quot;$(ThunderstoreDescription)&quot;,;  &quot;dependencies&quot;: [&quot;$(ThunderstoreDependency)&quot;];}" />
    <ZipDirectory SourceDirectory="$(PackageStageDir)" DestinationFile="$(RepoRoot)\dist\$(ThunderstoreName)-$(Version).zip" Overwrite="true" />
    <Message Importance="high" Text="Packaged $(RepoRoot)\dist\$(ThunderstoreName)-$(Version).zip" />
  </Target>

  <!-- After every build, copy the DLL into the r2modman Dev profile so the next game launch picks it up. -->
  <Target Name="DeployToProfile" AfterTargets="Build" Condition="Exists('$(ProfileDir)\BepInEx')">
    <MakeDir Directories="$(PluginDeployDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginDeployDir)" />
    <Message Importance="high" Text="Deployed $(TargetFileName) to $(PluginDeployDir)" />
  </Target>

</Project>
